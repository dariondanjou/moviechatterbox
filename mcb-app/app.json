{
  "expo": {
    "name": "MovieChatterbox",
    "slug": "moviechatterbox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moviechatterbox",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0D0B",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.moviechatterbox.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "MovieChatterbox uses your microphone when you speak in live Chatterboxes or record a voice note for feedback.",
        "NSCameraUsageDescription": "MovieChatterbox does not capture photos or video. This declaration is required by the audio engine framework the app is built on.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.moviechatterbox.app",
      "blockedPermissions": [
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0E0D0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@livekit/react-native-expo-plugin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0D0B",
          "image": "./assets/brand/icon-orange.png",
          "imageWidth": 120
        }
      ],
      "expo-audio",
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
